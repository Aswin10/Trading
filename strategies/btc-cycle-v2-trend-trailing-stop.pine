//@version=5
// ══════════════════════════════════════════════════════════════
// BTC Cycle Strategy V2 — Trend Following + Trailing Stop
// Timeframe: 1D | Pair: BTC/USD
//
// BEST RISK-ADJUSTED — Sharpe 1.12 | Near Buy & Hold returns
// Backtest: 5970% return | MaxDD -52.6% | 59% win rate | 17 trades
//
// Logic:
//   Buy: EMA50 > EMA200 (bull market) + Price > EMA50 + RSI > 50
//   Sell: Price drops 15% from 30-day high (trailing stop)
//         OR EMA50 crosses below EMA200 (death cross)
//   Rides the big trends, cuts losses with trailing stop
// ══════════════════════════════════════════════════════════════
strategy("BTC Cycle V2: Trend + Trailing Stop", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_value=0.1)

// ── Inputs ──
ema_fast_len   = input.int(50, "Fast EMA Length", minval=20, maxval=100)
ema_slow_len   = input.int(200, "Slow EMA Length", minval=100, maxval=400)
rsi_len        = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_threshold  = input.int(50, "RSI Buy Threshold", minval=30, maxval=60)
trail_lookback = input.int(30, "Trailing Stop Lookback (bars)", minval=10, maxval=60)
trail_pct      = input.float(15.0, "Trailing Stop %", minval=5.0, maxval=30.0) / 100

// ── Calculations ──
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
rsi_val  = ta.rsi(close, rsi_len)
highest  = ta.highest(close, trail_lookback)
trail_stop_level = highest * (1 - trail_pct)

// ── Buy Conditions ──
bull_market    = ema_fast > ema_slow
price_above_ma = close > ema_fast
momentum_ok    = rsi_val > rsi_threshold

// Only trigger on first bar meeting all conditions
was_not_valid = not (ema_fast[1] > ema_slow[1] and close[1] > ema_fast[1])
buy_signal = bull_market and price_above_ma and momentum_ok and was_not_valid

// ── Sell Conditions ──
trailing_stop_hit = close < trail_stop_level
death_cross = ta.crossunder(ema_fast, ema_slow)
sell_signal = trailing_stop_hit or death_cross

// ── Strategy Execution ──
if buy_signal
    strategy.entry("Long", strategy.long)

if sell_signal
    strategy.close("Long")

// ── Plotting ──
plot(ema_fast, "EMA 50", color=color.new(color.blue, 0), linewidth=2)
plot(ema_slow, "EMA 200", color=color.new(color.orange, 0), linewidth=2)
plot(strategy.position_size > 0 ? trail_stop_level : na, "Trailing Stop", color=color.new(color.red, 30), linewidth=1, style=plot.style_stepline)

bgcolor(strategy.position_size > 0 ? color.new(color.green, 92) : na)
plotshape(buy_signal, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(sell_signal and strategy.position_size > 0, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)
