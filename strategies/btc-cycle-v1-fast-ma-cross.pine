//@version=5
// ══════════════════════════════════════════════════════════════
// BTC Cycle Strategy V1 — Fast MA Crossover (21/55)
// Timeframe: 1D | Pair: BTC/USD
//
// BEST OVERALL — Beats Buy & Hold
// Backtest: 7239% return | Sharpe 1.12 | MaxDD -39% | 15 trades
//
// Logic:
//   Buy when EMA21 crosses above EMA55 (uptrend confirmed)
//   Sell when EMA21 crosses below EMA55 (trend reversal)
//   Simple trend-following that captures major BTC cycle moves
// ══════════════════════════════════════════════════════════════
strategy("BTC Cycle V1: Fast MA Cross", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_value=0.1)

// ── Inputs ──
fast_len = input.int(21, "Fast EMA Length", minval=5, maxval=50)
slow_len = input.int(55, "Slow EMA Length", minval=20, maxval=200)

// ── Calculations ──
ema_fast = ta.ema(close, fast_len)
ema_slow = ta.ema(close, slow_len)

// ── Signals ──
buy_signal  = ta.crossover(ema_fast, ema_slow)
sell_signal = ta.crossunder(ema_fast, ema_slow)

// ── Strategy Execution ──
if buy_signal
    strategy.entry("Long", strategy.long)

if sell_signal
    strategy.close("Long")

// ── Plotting ──
plot(ema_fast, "EMA Fast", color=color.new(color.green, 0), linewidth=2)
plot(ema_slow, "EMA Slow", color=color.new(color.red, 0), linewidth=2)

// Background color for position
bgcolor(strategy.position_size > 0 ? color.new(color.green, 90) : na)

// Signal markers
plotshape(buy_signal, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(sell_signal, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)
