//@version=5
// ══════════════════════════════════════════════════════════════
// BTC Cycle Strategy V3 — Cycle Composite (RSI + MACD + SMA)
// Timeframe: 1D | Pair: BTC/USD
//
// LOWEST DRAWDOWN — Max DD only -21.2%
// Backtest: 81.7% return | Sharpe 0.43 | 60% win rate | 5 trades
//
// Logic:
//   Buy: RSI(14) < 45 + MACD histogram > 0 + Price > SMA50
//        (triple confirmation: oversold + momentum + trend)
//   Sell: RSI > 70 (overbought) OR Price < SMA50 * 0.93 (stop loss)
//   Conservative approach — fewer trades, tight risk management
// ══════════════════════════════════════════════════════════════
strategy("BTC Cycle V3: Composite", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, initial_capital=10000, commission_value=0.1)

// ── Inputs ──
rsi_len       = input.int(14, "RSI Length", minval=5, maxval=30)
rsi_buy_level = input.int(45, "RSI Buy Threshold", minval=25, maxval=50)
rsi_sell_level= input.int(70, "RSI Sell Threshold", minval=60, maxval=85)
ma_len        = input.int(50, "SMA Length", minval=20, maxval=100)
macd_fast     = input.int(12, "MACD Fast", minval=5, maxval=20)
macd_slow     = input.int(26, "MACD Slow", minval=15, maxval=40)
macd_signal   = input.int(9, "MACD Signal", minval=5, maxval=15)
stop_pct      = input.float(7.0, "Stop Loss % below SMA", minval=3.0, maxval=15.0) / 100

// ── Calculations ──
rsi_val = ta.rsi(close, rsi_len)
[macd_line, signal_line, hist] = ta.macd(close, macd_fast, macd_slow, macd_signal)
sma_val = ta.sma(close, ma_len)
stop_level = sma_val * (1 - stop_pct)

// ── Buy: Triple confirmation ──
buy_rsi  = rsi_val < rsi_buy_level
buy_macd = hist > 0
buy_trend = close > sma_val
buy_signal = buy_rsi and buy_macd and buy_trend

// ── Sell: Overbought or stop loss ──
sell_overbought = rsi_val > rsi_sell_level
sell_stop = close < stop_level
sell_signal = sell_overbought or sell_stop

// ── Strategy Execution ──
if buy_signal
    strategy.entry("Long", strategy.long)

if sell_signal
    strategy.close("Long")

// ── Plotting ──
plot(sma_val, "SMA 50", color=color.new(color.blue, 0), linewidth=2)
plot(strategy.position_size > 0 ? stop_level : na, "Stop Level", color=color.new(color.red, 30), linewidth=1, style=plot.style_stepline)

bgcolor(strategy.position_size > 0 ? color.new(color.green, 92) : na)
plotshape(buy_signal and strategy.position_size == 0, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(sell_signal and strategy.position_size > 0, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)

// ── Info Table ──
var table info = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(info, 0, 0, "RSI", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, str.tostring(rsi_val, "#.0"), text_color=rsi_val < rsi_buy_level ? color.green : rsi_val > rsi_sell_level ? color.red : color.white, text_size=size.small)
    table.cell(info, 0, 1, "MACD Hist", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(hist, "#.0"), text_color=hist > 0 ? color.green : color.red, text_size=size.small)
    table.cell(info, 0, 2, "Trend", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, close > sma_val ? "BULL" : "BEAR", text_color=close > sma_val ? color.green : color.red, text_size=size.small)
    table.cell(info, 0, 3, "Signal", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, buy_signal ? "BUY" : sell_signal ? "SELL" : "HOLD", text_color=buy_signal ? color.green : sell_signal ? color.red : color.gray, text_size=size.small)
